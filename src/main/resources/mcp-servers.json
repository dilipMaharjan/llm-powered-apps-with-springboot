{
  "mcpServers": {
    "filesystem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--mount",
        "type=bind,src=/Users/crazdrms/projects/ai/springboot/llm-powered-apps-with-springboot/src/test/resources/mcp,dst=/app/projects",
        "mcp/filesystem",
        "/app/projects"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "spirng-ai-mcp": {
      "command": "/usr/bin/java",
      "args": [
        "-jar",
        "/Users/crazdrms/projects/ai/springboot/llm-powered-apps-with-springboot/target/llm-powered-apps-with-springboot-mcp-0.0.1-SNAPSHOT.jar"
      ]
    }
  }
}